import { useEffect, useState } from "react";
import axios from "axios";

function Profile() {

    const [user, setUser] = useState({});

    useEffect(() => {

        axios
            .get("http://localhost:3002/profile", {
                withCredentials: true,
            })
            .then((res) => {
                setUser(res.data.user);
            });

    }, []);

    return (

        <div>

            <h1>Profile</h1>

            <h3>{user.username}</h3>

            <p>{user.email}</p>

            <p>{user.phone}</p>

            <p>{user.bio}</p>

        </div>

    );
}

export default Profile;